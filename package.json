    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@atproto/lex": "^0.3.15",
    "@atproto/lex-password-session": "^0.2.4",
